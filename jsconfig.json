{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@shared/*": ["./src/shared/*"],
      "@context/*": ["./src/context/*"],
      "@features/*": ["./src/features/*"],
    },
    "checkJs": false,
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}